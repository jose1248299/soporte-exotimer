generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  TIMER
  BUYER
  ORGANIZER
  ATHLETE
  UNKNOWN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  WHATSAPP
}

enum MessageContentType {
  TEXT
  IMAGE
}

enum ConversationStatus {
  OPEN
  WAITING_HUMAN
  RESOLVED
}

enum SupportCaseStatus {
  OPEN
  WAITING_CLARIFICATION
  WAITING_HUMAN
  RESOLVED
}

enum SupportActionStatus {
  PROPOSED
  EXECUTED
  FAILED
  SKIPPED
}

model TimerContact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model Conversation {
  id             Int                @id @default(autoincrement())
  channel        MessageChannel     @default(WHATSAPP)
  phone          String
  displayName    String?
  userType       UserType           @default(UNKNOWN)
  status         ConversationStatus @default(OPEN)
  lastMessageAt  DateTime?
  confidence     Float?
  classification Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  messages Message[]
  actions  SupportAction[]
  cases    SupportCase[]

  @@unique([channel, phone])
  @@index([phone])
  @@index([userType])
  @@index([status])
  @@index([lastMessageAt])
}

model SupportCase {
  id             Int               @id @default(autoincrement())
  conversationId Int
  competitionId  Int?
  status         SupportCaseStatus @default(OPEN)
  userType       UserType          @default(UNKNOWN)
  athleteName    String?
  dorsal         String?
  detectedDorsals Json?
  detectedAthletes Json?
  subject        String?
  summary        String?
  classification Json?
  lastMessageAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     Message[]
  actions      SupportAction[]

  @@index([conversationId])
  @@index([competitionId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([competitionId, status, lastMessageAt])
}

model Message {
  id             Int              @id @default(autoincrement())
  conversationId Int
  supportCaseId  Int?
  competitionId  Int?
  waId           String?          @unique
  direction      MessageDirection
  contentType    MessageContentType @default(TEXT)
  phone          String
  content        String
  mediaId        String?
  mediaMimeType  String?
  mediaSha256    String?
  mediaFilename  String?
  mediaData      Bytes?
  mediaAnalysis  Json?
  rawPayload     Json?
  aiMetadata     Json?
  timestamp      DateTime         @default(now())
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  supportCase  SupportCase? @relation(fields: [supportCaseId], references: [id], onDelete: SetNull)

  @@index([conversationId, timestamp])
  @@index([supportCaseId, timestamp])
  @@index([competitionId, timestamp])
  @@index([phone])
}

model SupportAction {
  id             Int                 @id @default(autoincrement())
  conversationId Int
  supportCaseId  Int?
  messageId      Int?
  userType       UserType
  name           String
  status         SupportActionStatus @default(PROPOSED)
  input          Json
  output         Json?
  error          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  supportCase  SupportCase? @relation(fields: [supportCaseId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([supportCaseId])
  @@index([status])
  @@index([name])
}

model SupportPolicy {
  id            Int      @id @default(autoincrement())
  userType      UserType
  actionName    String
  enabled       Boolean  @default(false)
  requiresHuman Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userType, actionName])
  @@index([userType])
  @@index([actionName])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  uid       String?
  email     String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uid])
  @@index([active])
}
